<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{{ title }}{% if title != site.title %} · {{ site.title }}{% endif %}</title>
		<meta name="description" content="{{ description or site.description }}" />
		<meta name="theme-color" content="#16161a" />
		<link rel="stylesheet" href="/css/style.css" />
		<script>
			// Runs before first paint so a light-mode reader never sees a dark flash.
			try {
				var saved = localStorage.getItem("theme");
				if (saved === "light" || saved === "dark") {
					document.documentElement.dataset.theme = saved;
				}
			} catch (e) {}
		</script>
		<link
			rel="icon"
			href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>◆</text></svg>"
		/>
	</head>
	<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
		<header class="site-header">
			<a class="site-title" href="/">{{ site.title }}</a>
			<nav>
				{%- for item in site.nav %}
				{#- Prefix match so paginated children (/images/2/) keep the parent marked. -#}
				{%- set active = page.url == item.url or (item.url != "/" and page.url.startsWith(item.url)) %}
				<a href="{{ item.url }}"{% if active %} aria-current="page"{% endif %}>{{ item.label }}</a>
				{%- endfor %}
				<button type="button" id="theme-toggle" aria-label="Switch to light mode" aria-pressed="false">
					<svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
						<circle cx="12" cy="12" r="4.2" />
						<path d="M12 1.6v3M12 19.4v3M1.6 12h3M19.4 12h3M4.6 4.6l2.1 2.1M17.3 17.3l2.1 2.1M19.4 4.6l-2.1 2.1M6.7 17.3l-2.1 2.1" />
					</svg>
					<svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
						<path d="M21 13.2A9 9 0 1 1 10.8 3a7 7 0 0 0 10.2 10.2z" />
					</svg>
				</button>
			</nav>
		</header>

		<main>
			{{ content | safe }}
		</main>

		<footer class="site-footer">
			<p>© {{ site.author }}</p>
		</footer>

		<script>
			(function () {
				var root = document.documentElement;
				var button = document.getElementById("theme-toggle");
				var meta = document.querySelector('meta[name="theme-color"]');

				function apply(theme) {
					root.dataset.theme = theme;
					var toLight = theme === "dark";
					button.setAttribute("aria-label", toLight ? "Switch to light mode" : "Switch to dark mode");
					button.setAttribute("aria-pressed", String(theme === "light"));
					if (meta) {
						meta.setAttribute("content", theme === "light" ? "#fdfdfc" : "#16161a");
					}
				}

				apply(root.dataset.theme === "light" ? "light" : "dark");

				button.addEventListener("click", function () {
					var next = root.dataset.theme === "light" ? "dark" : "light";
					apply(next);
					try {
						localStorage.setItem("theme", next);
					} catch (e) {}
				});
			})();
		</script>
	</body>
</html>
