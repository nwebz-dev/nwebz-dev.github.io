---
layout: base.njk
title: Notes
permalink: /notes/
---

<h1>Notes</h1>

<p class="intro-note">
	Reference notes, published from my vault. Rougher than the writing — kept
	for my own use, shared in case they're useful.
</p>

<ul class="post-list">
	{%- for note in collections.notes %}
	<li>
		<a href="{{ note.url }}">{{ note.data.title }}</a>
		{%- if note.date %}
		<time datetime="{{ note.date | isoDate }}">{{ note.date | readableDate }}</time>
		{%- endif %}
	</li>
	{%- else %}
	<li>Nothing published yet.</li>
	{%- endfor %}
</ul>
